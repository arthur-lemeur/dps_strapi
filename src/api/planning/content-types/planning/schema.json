{
  "kind": "collectionType",
  "collectionName": "plannings",
  "info": {
    "singularName": "planning",
    "pluralName": "plannings",
    "displayName": "programme"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "day_number": {
      "type": "integer"
    },
    "date": {
      "type": "date"
    },
    "title": {
      "type": "string"
    },
    "edition": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "default": "[]",
      "options": [
        "Spring",
        "Fall"
      ]
    },
    "entry": {
      "type": "component",
      "component": "programme.day-entry",
      "repeatable": true
    }
  }
}
