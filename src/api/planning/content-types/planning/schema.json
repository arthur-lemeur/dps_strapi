{
  "kind": "collectionType",
  "collectionName": "plannings",
  "info": {
    "singularName": "planning",
    "pluralName": "plannings",
    "displayName": "programme"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "date": {
      "type": "date"
    },
    "time": {
      "type": "time"
    },
    "title": {
      "type": "string"
    },
    "speakers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::speaker.speaker",
      "mappedBy": "planning"
    },
    "desc": {
      "type": "text"
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "talk",
        "break"
      ]
    },
    "preview": {
      "type": "boolean"
    },
    "edition": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "default": "[]",
      "options": [
        "Spring",
        "Fall"
      ]
    }
  }
}
