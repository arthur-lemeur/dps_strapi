{
  "kind": "collectionType",
  "collectionName": "ticket_tiers",
  "info": {
    "singularName": "ticket-tier",
    "pluralName": "ticket-tiers",
    "displayName": "Ticket tier"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "desc": {
      "type": "text"
    },
    "price": {
      "type": "integer"
    },
    "priceNote": {
      "type": "boolean"
    },
    "featured": {
      "type": "boolean"
    },
    "perks": {
      "type": "richtext",
      "default": "Full access to both Summit days, Lunches & coffee breaks, Evening cocktail reception, 20% XML Toronto discount code"
    },
    "edition": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "default": "[]",
      "options": [
        "Spring",
        "Fall"
      ]
    }
  }
}
