{
  "kind": "collectionType",
  "collectionName": "speakers",
  "info": {
    "singularName": "speaker",
    "pluralName": "speakers",
    "displayName": "speaker"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "bio": {
      "type": "text"
    },
    "photo_url": {
      "type": "string"
    },
    "photo_media": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "initials": {
      "type": "string"
    },
    "archive_video": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::archive-video.archive-video",
      "inversedBy": "speakers"
    },
    "preview": {
      "type": "boolean"
    },
    "edition": {
      "type": "customField",
      "customField": "plugin::multi-select.multi-select",
      "default": "[]",
      "options": [
        "Spring",
        "Fall"
      ]
    }
  }
}
